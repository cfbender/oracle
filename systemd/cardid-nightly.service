[Unit]
Description=Pull corrections and conditionally publish a better card recognizer
# Every path below assumes the checkout lives at ~/the-gathering; ideally in the home of a
# dedicated unprivileged account (see ml/README.md, "Optional nightly loop").

[Service]
Type=oneshot
WorkingDirectory=%h/the-gathering/ml
# No EnvironmentFile=: nightly.sh reads ~/.config/cardid.env (or $CARDID_ENV_FILE) itself as
# literal KEY=value data via cardid.envfile, so there is exactly one parser.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# uv needs a writable cache even for `uv run --no-sync`; keep it in the private /tmp.
Environment=UV_CACHE_DIR=/tmp/uv-cache
# ROCm's MIOpen kernel database/cache would otherwise go to ~/.config and ~/.cache.
Environment=MIOPEN_USER_DB_PATH=%h/the-gathering/ml/data/cache/miopen MIOPEN_CUSTOM_CACHE_DIR=%h/the-gathering/ml/data/cache/miopen
ExecStart=/bin/bash %h/the-gathering/ml/nightly.sh
IOSchedulingClass=idle
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=control-group

# Sandboxing. In a user unit these imply PrivateUsers=true, which needs unprivileged user
# namespaces (kernel.unprivileged_userns_clone=1 where that sysctl exists).
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
# The whole filesystem is read-only except the ML data directory, which holds everything the
# job writes: data/nightly (lock, logs, state, reports), data/real (pulled corrections and
# cursor), data/runs (checkpoints), data/bundles (exports), data/cache and the gallery/
# eval-query caches. Temporary baseline snapshots and export tarballs use the private /tmp.
ProtectSystem=strict
ReadWritePaths=%h/the-gathering/ml/data
# Home stays readable: the checkout and its .venv, ~/.config/cardid.env, and ~/.ssh (keys,
# config, known_hosts) for rsync/ssh publication. Nothing in it is writable except the path
# above, so accept the publish host's key interactively once before enabling the timer.
# Publishing to a local directory instead of ssh needs that directory added to
# ReadWritePaths= in a drop-in (systemctl --user edit cardid-nightly.service).
ProtectHome=read-only
