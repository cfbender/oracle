# Save as ~/.config/cardid.env and chmod 600. Read as data by retrain and nightly.sh
# (cardid.envfile), never sourced: one literal KEY=value per line, quote values with spaces,
# whole-line # comments only. $VAR, $(...) and backticks are NOT expanded. Only CARDID_*
# keys are used, and variables already set in the environment win over this file.
CARDID_SERVER=https://games.example.com
# ManaVault's scanner captures (the URL names its corrections endpoint):
# CARDID_SERVER=https://manavault.example.com/api/scanner/corrections
# Train and evaluate on one app's captures only (webcam-table, manavault-scanner, capture):
# CARDID_SOURCES=manavault-scanner
CARDID_CORRECTIONS_TOKEN=replace-with-server-read-only-export-token
# Alternative to HTTP (mount or rsync into this directory):
# CARDID_CORRECTIONS_DIR=/mnt/gathering/cardid/corrections
# Where bundles go: an ssh host path (The Gathering), a local directory, or a GitHub
# release per bundle (ManaVault; needs `gh auth login` with write access).
CARDID_PUBLISH_TO=user@host:/srv/the-gathering/cardid
# CARDID_PUBLISH_TO=github:cfbender/manavault
# Optional extra search paths. Both loops first match current/manifest.json's hashes
# against data/runs/*/{best,last}.pt. Retrain flags --checkpoint/--detector override.
# Successful publications remember both paths in data/nightly/state.json.
# The defaults are the committed starting weights (see README "Starting weights").
CARDID_CHECKPOINT=models/recogniser.pt
CARDID_DETECTOR=models/detector.pt
# Manual retrain defaults to four epochs; nightly keeps its two-epoch budget.
CARDID_RETRAIN_EPOCHS=4
CARDID_EPOCHS=2
# Shared worker override; comment out for device-aware defaults in manual retrain.
CARDID_WORKERS=2
CARDID_BUDGET=2h
CARDID_NICE=15
