# Save as ~/.config/cardid.env and chmod 600. Shared shell/systemd syntax: no export.
CARDID_SERVER=https://games.example.com
CARDID_CORRECTIONS_TOKEN=replace-with-server-read-only-export-token
# Alternative to HTTP (mount or rsync into this directory):
# CARDID_CORRECTIONS_DIR=/mnt/gathering/cardid/corrections
CARDID_PUBLISH_TO=nuc:/srv/the-gathering/cardid
# Optional extra search paths. Both loops first match current/manifest.json's hashes
# against data/runs/*/{best,last}.pt. Retrain flags --checkpoint/--detector override.
# Successful publications remember both paths in data/nightly/state.json.
CARDID_CHECKPOINT=data/runs/full-3/best.pt
CARDID_DETECTOR=data/runs/det4/last.pt
# Manual retrain defaults to four epochs; nightly keeps its two-epoch budget.
CARDID_RETRAIN_EPOCHS=4
CARDID_EPOCHS=2
# Shared worker override; comment out for device-aware defaults in manual retrain.
CARDID_WORKERS=2
CARDID_BUDGET=2h
CARDID_NICE=15
