# The Gathering webcam-table model. `mise run setup-profiles` copies this to
# ~/.config/cardid/the-gathering.env (chmod 600); then fill in the server and token.
CARDID_PROFILE=the-gathering
CARDID_SERVER=https://games.example.com
CARDID_CORRECTIONS_TOKEN=replace-with-server-read-only-export-token
CARDID_PUBLISH_TO=nuc:/srv/the-gathering/cardid
# Webcam captures: table corrections plus the local cardid.capture tool.
CARDID_SOURCES=webcam-table,capture
CARDID_CHECKPOINT=models/recogniser.pt
CARDID_DETECTOR=models/detector.pt
