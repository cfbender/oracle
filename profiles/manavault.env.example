# ManaVault phone scanner model. `mise run setup-profiles` copies this to
# ~/.config/cardid/manavault.env (chmod 600); then fill in the server and token.
CARDID_PROFILE=manavault
# The scanner's corrections endpoint and the server's SCANNER_CORRECTIONS_TOKEN.
CARDID_SERVER=https://manavault.example.com/api/scanner/corrections
CARDID_CORRECTIONS_TOKEN=replace-with-SCANNER_CORRECTIONS_TOKEN
CARDID_PUBLISH_TO=github:cfbender/manavault
# Train and evaluate on phone scans only.
CARDID_SOURCES=manavault-scanner
# Starting weights; retrain prefers the checkpoints behind the currently published bundle.
CARDID_CHECKPOINT=models/recogniser.pt
CARDID_DETECTOR=models/detector.pt
